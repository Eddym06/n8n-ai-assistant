    {
      "parameters": {
        "model": "gpt-4",
        "messages": {
          "messages": [
            {
              "role": "system",
              "content": "You are a Candidate Shortlisting Agent. Analyze job descriptions and candidate profiles to shortlist qualified applicants. Schedule interviews for selected candidates."
            },
            {
              "role": "user",
              "content": "Shortlisting request: {{ $json.message_body }}"
            }
          ]
        },
        "options": {}
      },
      "id": "13da2613-9548-4986-8919-2ab9d3509685",
