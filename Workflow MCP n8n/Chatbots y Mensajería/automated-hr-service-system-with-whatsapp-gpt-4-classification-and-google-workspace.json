            {
              "role": "system",
              "content": "You are a Complaint/Request Escalation Agent. Generate professional emails to department heads for employee complaints and requests that need managerial attention."
            },
            {
              "role": "user",
              "content": "Complaint/Request: {{ $json.message_body }}"
            }
          ]
        },
        "options": {}
      },
