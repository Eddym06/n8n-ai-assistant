      "parameters": {
        "functionCode": "const products = $input.all();\nconst lowStockThreshold = 10; // Define tu umbral de stock bajo\n\nconst lowStockProducts = products.filter(p => p.json.fields.Stock <= lowStockThreshold);\n\nreturn lowStockProducts;"
