    {
      "id": "validar-datos-pedido",
      "name": "Validar Datos Pedido",
      "type": "n8n-nodes-base.function",
      "position": [
        800,
        -170
      ],
      "parameters": {
        "functionCode": "const order = $input.first().json;\n\nlet isValid = true;\nlet validationErrors = [];\n\nif (!order.customerEmail || !order.customerEmail.includes('@')) {\n  isValid = false;\n  validationErrors.push('Email inválido');\n}\n\nif (!order.shippingAddress || !order.shippingAddress.address1) {\n  isValid = false;\n  validationErrors.push('Dirección de envío inválida');\n}\n\nif (!order.products || order.products.length === 0) {\n  isValid = false;\n  validationErrors.push('No hay productos en el pedido');\n}\n\nreturn [{ json: { ...order, isValid, validationErrors } }];"
      },
      "credentials": {}
    },
