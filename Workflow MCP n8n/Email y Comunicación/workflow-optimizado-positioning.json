    {
      "id": "function-generar-resumen-reporte",
      "name": "Function: Generar Resumen Reporte",
      "type": "n8n-nodes-base.function",
      "position": [
        800,
        370
      ],
      "parameters": {
        "functionCode": "const orders = $input.all().map(item => item.json);\n\nconst totalOrders = orders.length;\nconst totalRevenue = orders.reduce((sum, order) => sum + parseFloat(order.totalAmount), 0);\nconst processedOrders = orders.filter(order => order.status === 'procesado').length;\n\nreturn [{ json: { totalOrders, totalRevenue, processedOrders, reportDate: new Date().toISOString().split('T')[0] } }];"
      },
      "credentials": {}
    },
