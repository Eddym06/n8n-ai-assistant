    {
      "id": "function-calcular-totales",
      "name": "Function: Calcular Totales (Impuestos, Envío, Descuentos)",
      "type": "n8n-nodes-base.function",
      "position": [
        2900,
        -80
      ],
      "parameters": {
        "functionCode": "const order = $input.first().json;\n\nlet subtotal = order.products.reduce((sum, p) => sum + (p.price * p.quantity), 0);\nlet shippingCost = 10; // Ejemplo\nlet taxRate = 0.08; // Ejemplo 8%\nlet discount = 0; // Ejemplo\n\n// Aplicar cupones/descuentos (lógica más compleja aquí)\nif (order.couponCode === 'SAVE10') {\n  discount = subtotal * 0.10;\n}\n\nlet taxes = (subtotal - discount + shippingCost) * taxRate;\nlet finalTotal = subtotal - discount + shippingCost + taxes;\n\nreturn [{ json: { ...order, subtotal, shippingCost, taxes, discount, finalTotal } }];"
      },
      "credentials": {}
    },
