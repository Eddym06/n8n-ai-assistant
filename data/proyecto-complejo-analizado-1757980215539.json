{
  "nodes": [
    {
      "parameters": {
        "path": "/lead-capture",
        "responseMode": "lastNode",
        "options": {}
      },
      "name": "Lead Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "values": [
          {
            "name": "clean_email",
            "value": "={{$json.email.toLowerCase().trim()}}"
          },
          {
            "name": "budget_number",
            "value": "={{parseInt($json.budget) || 0}}"
          },
          {
            "name": "is_valid",
            "value": "={{$json.name && $json.email && $json.company}}"
          }
        ],
        "options": {}
      },
      "name": "Validate Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.is_valid}}",
              "value2": true
            }
          ]
        }
      },
      "name": "Is Valid Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "url": "YOUR_DATABASE_API_ENDPOINT/leads/{{$json.clean_email}}",
        "options": {
          "returnFullResponse": false
        },
        "method": "GET"
      },
      "name": "Check Existing Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$node[\"Check Existing Lead\"].json.status}}",
              "value2": 200,
              "operation": "=="
            }
          ]
        }
      },
      "name": "Lead Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "listId": "YOUR_MAILCHIMP_LIST_ID",
        "emailAddress": "={{$json.clean_email}}",
        "status": "subscribed",
        "mergeFieldsUi": {
          "mergeFieldsValues": [
            {
              "name": "FNAME",
              "value": "={{$json.name}}"
            },
            {
              "name": "COMPANY",
              "value": "={{$json.company}}"
            }
          ]
        },
        "options": {
          "doubleOptin": false,
          "updateExisting": false
        }
      },
      "name": "Add to MailChimp",
      "type": "n8n-nodes-base.mailchimp",
      "typeVersion": 1,
      "position": [
        1100,
        150
      ]
    },
    {
      "parameters": {
        "subject": "Welcome to our Company!",
        "recipients": {
          "to": [
            {
              "email": "={{$json.clean_email}}",
              "name": "={{$json.name}}"
            }
          ]
        },
        "content": "<h1>Welcome!</h1><p>Thank you for your interest.</p>",
        "options": {}
      },
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "channel": "YOUR_SLACK_CHANNEL_ID",
        "text": "New Lead: {{$json.name}} - {{$json.clean_email}} - {{$json.company}} - Budget: {{$json.budget}}",
        "options": {}
      },
      "name": "Slack Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        1100,
        450
      ]
    },
    {
      "parameters": {
        "databaseId": "YOUR_NOTION_DATABASE_ID",
        "propertiesUi": {
          "propertyValues": [
            {
              "propertyId": "title",
              "name": "Name",
              "value": "={{$json.name}}"
            },
            {
              "propertyId": "email",
              "name": "Email",
              "value": "={{$json.clean_email}}"
            },
            {
              "propertyId": "company",
              "name": "Company",
              "value": "={{$json.company}}"
            },
            {
              "propertyId": "budget",
              "name": "Budget",
              "value": "={{$json.budget}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Create Notion Task",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 1,
      "position": [
        1100,
        600
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.budget_number}}",
              "value2": 5000,
              "operation": ">"
            }
          ]
        }
      },
      "name": "High Value Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1300,
        150
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "VIP Lead Alert: {{$json.name}} - {{$json.clean_email}} - Budget: {{$json.budget}}",
        "options": {}
      },
      "name": "Telegram Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1500,
        150
      ]
    },
    {
      "parameters": {
        "spreadsheetId": "YOUR_GOOGLE_SHEET_ID",
        "range": "Sheet1!A1",
        "valueInputOption": "USER_ENTERED",
        "includeValuesInResponse": false,
        "values": "=[[$json.name, $json.clean_email, $json.company, $json.budget, $json.source, $json.timestamp]]",
        "options": {}
      },
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [
        1100,
        750
      ]
    },
    {
      "parameters": {
        "mode": "every",
        "value": 3,
        "unit": "days",
        "timeZone": "UTC",
        "startAt": "={{new Date(Date.now() + (3 * 24 * 60 * 60 * 1000)).toISOString()}}"
      },
      "name": "Schedule Follow-up",
      "type": "n8n-nodes-base.schedule",
      "typeVersion": 1,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "subject": "Follow-up Email",
        "recipients": {
          "to": [
            {
              "email": "={{$json.clean_email}}",
              "name": "={{$json.name}}"
            }
          ]
        },
        "content": "<h1>Following Up</h1><p>Just checking in!</p>",
        "options": {}
      },
      "name": "Send Follow-up Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        1500,
        300
      ]
    },
    {
      "parameters": {
        "url": "YOUR_DATABASE_API_ENDPOINT/leads/{{$json.clean_email}}",
        "options": {
          "returnFullResponse": false
        },
        "method": "PUT",
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "is_recurring",
              "value": true
            }
          ]
        }
      },
      "name": "Update Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1100,
        900
      ]
    },
    {
      "parameters": {
        "continueOnFail": true
      },
      "name": "Error Trigger",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        300,
        450
      ]
    },
    {
      "parameters": {
        "channel": "YOUR_SLACK_CHANNEL_ID",
        "text": "Error processing lead: {{$json.email}} - {{$json.message}}",
        "options": {}
      },
      "name": "Slack Error Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        500,
        450
      ]
    }
  ],
