    },
    {
      "id": "if-2",
      "name": "Test IF",
      "type": "n8n-nodes-base.if", 
      "position": [500, 100],
      "parameters": {
        "conditions": [
          {
            "leftValue": "={{$json.testField}}",
            "rightValue": "test value",
            "operation": "equal"
          }
        ]
      },
      "typeVersion": 1
    }
  ],
  "connections": {
    "Test Webhook": {
      "main": [
        [
          {
